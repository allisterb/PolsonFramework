<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Polson.Drawing.Svg</RootNamespace>
    <AssemblyVersion>$(ProjectAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProjectAssemblyVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- So the attribute round-trip guard can enumerate the element factory rather than repeat a
         list of its own. These stay internal deliberately: every public member of a type Jint can
         reach becomes script surface, and ApiDocumentationTests then requires it to be documented. -->
    <InternalsVisibleTo Include="Polson.Tests.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="5.2.1" />
    <PackageReference Include="Svg.Custom" Version="5.2.1" />
    <PackageReference Include="Svg.Model" Version="5.2.1" />
    <PackageReference Include="AngleSharp" Version="1.7.2" />
    <PackageReference Include="AngleSharp.Css" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polson.Runtime\Polson.Runtime.csproj" />
  </ItemGroup>

</Project>
