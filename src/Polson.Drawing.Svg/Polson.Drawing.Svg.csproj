<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Polson.Drawing.Svg</RootNamespace>
    <AssemblyVersion>$(ProjectAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProjectAssemblyVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="5.2.1" />
    <PackageReference Include="Svg.Custom" Version="5.2.1" />
    <PackageReference Include="Svg.Model" Version="5.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polson.Runtime\Polson.Runtime.csproj" />
    <!-- For paper.style(css): the CSS parser already exists rather than being written twice.
         HtmlParser is a leaf with no project references of its own, so this stays acyclic. -->
    <ProjectReference Include="..\Polson.HtmlParser\Polson.HtmlParser.csproj" />
  </ItemGroup>

</Project>
