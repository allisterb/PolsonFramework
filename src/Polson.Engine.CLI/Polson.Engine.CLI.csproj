<Project Sdk="Microsoft.NET.Sdk">

  <!-- Polson Engine's command line: `eval` and `server` (stdio or HTTP MCP). The handlers are the studio CLI's own,
       compiled here from Polson.CLI/Program.Engine.cs; Program.cs in this directory is the engine's entry point and
       startup, which configures the local tools and no cloud service. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Polson.CLI</RootNamespace>
    <AssemblyVersion>$(ProjectAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProjectAssemblyVersion)</FileVersion>
    <!-- As the studio's CLI, and for its reason: the engine's per-pixel work is loops, optimised from the first call. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <!-- A release is one executable per platform, with the runtime and the Skia and HarfBuzz natives inside it. Only a
       publish that names a platform (-r) takes these, so an ordinary build stays portable. tools/publish-engine.py
       publishes from a copy of the source, because a -r restore adds a platform section to the lock file of every
       project the engine references. -->
  <PropertyGroup Label="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <AssemblyName>polson-engine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Polson.CLI\Options.cs;..\Polson.CLI\Program.Engine.cs" LinkBase="CLI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polson.Engine\Polson.Engine.csproj" />
    <ProjectReference Include="..\Polson.Runtime\Polson.Runtime.csproj" />
  </ItemGroup>

</Project>
