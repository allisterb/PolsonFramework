<Project>
  <PropertyGroup Label="Settings">
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>NETSDK1233</NoWarn>
  </PropertyGroup>

  <!-- Repository root. $(SolutionDir) is only set when MSBuild is driven by the .sln, so targets that
       write to a central directory must use this instead to survive a direct `dotnet build`/`dotnet test`. -->
  <PropertyGroup Label="Layout">
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <!-- Shared assembly version. Projects opt in by mapping their AssemblyVersion /
       FileVersion / Version to this property, so bumping the version here restamps them all on the next build. -->
  <PropertyGroup Label="Versioning">
    <ProjectAssemblyVersion>0.1.0</ProjectAssemblyVersion>

    <!-- Version is the one the CLI prints. AssemblyVersion and FileVersion were mapped per project
         and Version was not, so it kept the SDK default of 1.0.0 and the banner reported a version
         no file agreed with. Set here so every project inherits it. -->
    <Version>$(ProjectAssemblyVersion)</Version>
  </PropertyGroup>

  <!-- Supply chain. A lock file records the exact resolved graph, transitive packages included, so a
       restore either reproduces what was reviewed or fails. Without it a floating transitive
       dependency can change underneath a build that looks unchanged.

       Commit every packages.lock.json. In CI, restore in locked mode (the RestoreLockedMode
       property, or the equivalent CLI flag), which refuses to update the lock rather than silently
       re-resolving. Locally, adding or bumping a package updates the lock as part of restore;
       review that diff like any other.

       NuGetAudit checks the resolved graph against the vulnerability database at restore time.
       Auditing 'all' covers transitive packages too, which is where this class of problem usually
       arrives. It reports; it does not fail the build. -->
  <PropertyGroup Label="Supply Chain">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>
</Project>