{
  "multiAgent": {
    "enabled": true,
    "strategy": "sequential_pipeline",
    "maxRefinementPasses": 2,
    "sharedWorkspace": true,
    "artifactDirectory": "artifacts"
  },
  "mcp": {
    "autoApprove": [
      "polson.ExecuteScript",
      "polson.MeasureSvgPath",
      "polson.History",
      "polson.RenderSvg"
    ]
  },
  "rendering": {
    "defaultFormat": "webp",
    "defaultQuality": 85,
    "directToFile": true
  }
}
