<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- `clear` drops any source inherited from the machine or user-level NuGet.config. Without it a
       feed configured elsewhere on this machine silently joins the restore, and whichever source
       offers the highest version can win — which is how dependency confusion works. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Source mapping makes the binding explicit rather than implied by there being only one source.
       It matters the moment a private or preview feed is added: without a mapping, every package is
       eligible from every source, and a public package with a matching name can be served from the
       wrong one. Adding a feed means adding its patterns here, deliberately. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Fail on a package whose signature is invalid or tampered with, rather than warning. -->
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>

  <!-- `require` above is only half a policy: it means "signed by a *trusted* signer", so with this
       section empty every package is refused and restore fails closed. That failure stayed hidden
       for as long as every package was already in the global cache — a cache hit is not re-validated,
       so the rule was first exercised by the first genuinely new package.

       Every package on nuget.org carries that feed's repository countersignature, so trusting the
       repository covers the whole source without naming individual authors. The fingerprints below
       were written by `dotnet nuget trust source nuget.org`, which reads them from the feed's own
       service index rather than from anywhere they could be transcribed wrongly; there are three
       because nuget.org publishes its successor certificates ahead of rotation. Refresh them with
       `dotnet nuget trust sync nuget.org`, and review the diff — a fingerprint changing is exactly
       the event this setting exists to make visible. -->
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>

</configuration>
