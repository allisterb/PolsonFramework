# Copy to `.env` in this directory and fill in. ADK's agent loader calls `load_dotenv_for_agent`
# before importing an app, walking up from the app directory until it finds a `.env` — so one here
# covers every generated app under `apps/`. Explicitly-set environment variables win over it.
#
# `.env` holds a credential and is NOT committed — `*.env` in the root .gitignore covers it.
#
# > Resolution is FIRST-FOUND-WINS, not layered. A `.env` placed inside `apps/<name>/` shadows this
# > file entirely rather than overriding single keys, so such a file must be complete. Verified.

# ---------------------------------------------------------------------------------------------
# Credentials. The only thing genuinely required.
# ---------------------------------------------------------------------------------------------
# The key in bin/cli/appsettings.json under ApiKeys:GoogleAgentPlatform is a Gemini Enterprise
# Agent Platform credential (prefix `AQ.A`), not a public Gemini key (`AIza`) — it needs the
# enterprise endpoint, which is what the flag below selects. This mirrors what the .NET side does
# with `new Client(enterprise: true, ...)` and what ADK's own Dockerfile template sets.
#
# GOOGLE_GENAI_USE_VERTEXAI is the deprecated spelling of the same flag in ADK 2.8.0; it warns.
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_API_KEY=

# For Vertex AI via application-default credentials instead of a key, leave GOOGLE_API_KEY empty,
# run `gcloud auth application-default login`, and set these:
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=

# ---------------------------------------------------------------------------------------------
# There is no POLSON_PROJECT_DIR.
# ---------------------------------------------------------------------------------------------
# Each app under `apps/` is generated with its project path baked in, so the project is a property
# of the app rather than of the process. Create one with:
#
#   python-adk/Scripts/python.exe src/adk_agent/newproject.py <id> --workflow logo --prompt "..."
#
# That writes projects/<id>/ and apps/<id>/, and serves it at /apps/<id>/... with no restart.

# ---------------------------------------------------------------------------------------------
# Optional.
# ---------------------------------------------------------------------------------------------
# The reasoning model for every agent. Defaults to gemini-3.7-flash (see studio.py).
#
# Measured against the appsettings.json key on the deployment, latency re-probed
# 2026-09-06 as the median of three calls, with the tokens each spent on the same prompt:
#   gemini-2.5-flash   1.0s    130 tok    cheapest per token, and the fastest here
#   gemini-3.5-flash   3.8s    485 tok
#   gemini-3.7-flash   4.3s    467 tok    the default
#   gemini-2.5-pro    11.8s   1260 tok
#   404 NOT_FOUND      gemini-3-pro, gemini-3-pro-preview, gemini-3-flash
#
# So the step up is gemini-2.5-pro, not a Gemini 3 name; a model the key cannot serve fails at
# the first turn, not at load.
#
# **Set gemini-2.5-flash while iterating on prompts and tools** — roughly half the cost of 3.7 and
# no slower. What it does NOT tell you is whether a piece is as good: 3.x spends three to four
# times the tokens on the same question because it thinks first, and an eighty-turn staged brief
# is where that shows. Judge the artifact before adopting a cheaper tier for real work.
# POLSON_MODEL=gemini-2.5-flash

# The built MCP server. Defaults to <repo>/bin/cli/Polson.CLI.dll; set it for a container, where the
# layout is not the repository's.
# POLSON_CLI_DLL=/app/bin/cli/Polson.CLI.dll

# Serve ADK's bundled dev console (the Angular SPA in the wheel) alongside the REST API.
# On by default. Turn it off for a public deployment where the studio UI is the front door.
# POLSON_SERVE_CONSOLE=0

# Session persistence. Absent means in-memory, which loses a run on restart.
# POLSON_SESSION_SERVICE_URI=sqlite:///./polson_sessions.db

# Comma-separated CORS origins. Absent means none.
# POLSON_ALLOW_ORIGINS=http://127.0.0.1:8000
