<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>$(ProjectAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProjectAssemblyVersion)</FileVersion>
  </PropertyGroup>

  <!-- MIT, unlike the AGPL-3.0 of the rest of the repository: see LICENSE in this directory. It must reference no
       AGPL project (Polson.Animation, Polson.MCPServer, Polson.ExtendedMind, Polson.Engine); LicenceBoundaryTests
       fails the build's tests if one does. -->
  <PropertyGroup Label="Licence">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Allister Beharry</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polson.Tests.Drawing" />
    <InternalsVisibleTo Include="Polson.MCPServer" />
    <InternalsVisibleTo Include="Polson.Engine" />
    <InternalsVisibleTo Include="Polson.Drawing.Mesh" />
    <InternalsVisibleTo Include="Polson.Tests.Drawing.Mesh" />
    <InternalsVisibleTo Include="Polson.Animation" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CSharpMath.Rendering" Version="1.0.0-pre.2" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="AngouriMath" Version="2.5.0" />    
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" />
  </ItemGroup>

  <!-- Unicode CLDR number formats, generated by tools/cldr_gen.js; carries the Unicode License notice in its own header. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\cldr-numbers.json" LogicalName="Polson.Drawing.Skia.cldr-numbers.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polson.Runtime\Polson.Runtime.csproj" />
    <ProjectReference Include="..\Polson.Drawing.Svg\Polson.Drawing.Svg.csproj" />
  </ItemGroup>

</Project>
