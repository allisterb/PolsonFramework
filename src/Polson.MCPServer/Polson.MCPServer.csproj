<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>$(ProjectAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProjectAssemblyVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.9.2" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\*.md" Link="docs\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\docs\manuals\*.md" Link="docs\manuals\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- `Explain` turns a runtime failure into guidance an agent can act on, and its native-library
         branch cannot be reached by running a script — the whole point is that the platform is
         broken. Testing it directly beats leaving the one path that only ever fires in a crisis
         unexercised. -->
    <InternalsVisibleTo Include="Polson.Tests.MCPServer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polson.ExtendedMind\Polson.ExtendedMind.csproj" />
    <ProjectReference Include="..\Polson.Runtime\Polson.Runtime.csproj" />
    <ProjectReference Include="..\Polson.Drawing.Svg\Polson.Drawing.Svg.csproj" />
    <ProjectReference Include="..\Polson.Drawing.Skia\Polson.Drawing.Skia.csproj" />
    <!-- Referenced here rather than from the drawing projects on purpose: the CSS layer produces
         plain data and the drawing stack consumes it, so AngleSharp never enters the render path. -->
    <ProjectReference Include="..\Polson.HtmlParser\Polson.HtmlParser.csproj" />
  </ItemGroup>

</Project>
