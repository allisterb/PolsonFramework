<Project Sdk="Microsoft.NET.Sdk">

  <!-- The 3D half of the drawing SDK: glTF meshes, rigs and posing, faces as meshes, characters,
       and the MediaPipe and Blender processes they use. It draws through Polson.Drawing.Skia and
       nothing there depends on it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion>$(ProjectAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(ProjectAssemblyVersion)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Polson.Tests.Drawing.Mesh" />
    <InternalsVisibleTo Include="Polson.MCPServer" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Polson.Drawing.Skia" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpGLTF.Core" Version="1.0.7" />
    <PackageReference Include="SharpGLTF.Runtime" Version="1.0.7" />
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" />
  </ItemGroup>

  <!-- The stock bodies and pose clips (CC0; see Library/README.md), fetched into Library/ by tools/fetch-assets.py.
       Copied next to the assembly, and from there into every project that references this one. A build before
       the fetch still succeeds, and Character.stock then says what is missing. -->
  <ItemGroup>
    <None Update="Library\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Polson.Runtime\Polson.Runtime.csproj" />
    <ProjectReference Include="..\Polson.Drawing.Skia\Polson.Drawing.Skia.csproj" />
  </ItemGroup>

</Project>
