#! /usr/bin/env bash
#
# Polson's entry point. Dispatches the verb to the .NET CLI or to Python.
#
#   server, eval, create-project, reset, report,           the .NET CLI, bin/cli
#   help, version
#   studio                                                 Python, src/studio
#   orchestrator                                           Python, src/orchestrator
#
# The split follows where the code already is. `server` IS the MCP server and `eval`, `report` and
# `create-project` are C#-fronted; the studio is a FastAPI application with its own argparse, and a
# CLI verb for it would re-declare every one of its options in a second place, then spawn Python
# anyway. Branching here is that dispatch without the second copy of the flags and without the
# process hop.
#
# Arguments are forwarded verbatim and the exit code is passed through, so anything documented for
# `polson report` or for `python -m studio` works here unchanged.
#
# Interpreter and binary are found in this order:
#
#   POLSON_PYTHON, then the repo venv at python/, then python3 / python on PATH
#   POLSON_CLI, then bin/cli/Polson.CLI.exe, then bin/cli/Polson.CLI.dll through dotnet
#
# POLSON_CLI may name either the managed dll or a self-contained executable; a .dll is run through
# `dotnet` and anything else is run directly.
#
# Keep this in step with polson.ps1, which does the same job on Windows.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The routing table, and the only place a new Python verb needs adding. A case rather than an
# associative array, which bash 3.2 — still the /bin/bash on macOS — does not have.
python_module() {
    case "$1" in
        studio)       echo "studio" ;;
        orchestrator) echo "orchestrator" ;;
        *)            return 1 ;;
    esac
}

# Which verbs need the driver lock rather than the base one. `studio` deliberately does not: it
# serves and reads a record, which is 17 packages against 52, and that is the whole reason the two
# requirement files are separate. `orchestrator` drives an agent, so it does.
needs_driver() {
    case "$1" in
        orchestrator) return 0 ;;
        *)            return 1 ;;
    esac
}

is_help_token() {
    case "$1" in
        help|--help|-h|-\?) return 0 ;;
        *)                  return 1 ;;
    esac
}

find_python() {
    # Trusted as given: a caller who set it knows better than this search does.
    if [ -n "${POLSON_PYTHON:-}" ]; then
        echo "$POLSON_PYTHON"
        return
    fi

    # `python/` and not `python-adk/`. The two venvs are deliberately separate — ADK caps
    # websockets<16 where the studio's lock resolves it to 16.1.1, so in one shared environment the
    # second install silently wins and neither lock then describes what is installed. See CLAUDE.md.
    #
    # Windows here means git bash / MSYS, where a venv keeps its interpreter under Scripts.
    local candidates
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) candidates=("$repo_root/python/Scripts/python.exe") ;;
        *)                    candidates=("$repo_root/python/bin/python3" "$repo_root/python/bin/python") ;;
    esac

    local candidate
    for candidate in "${candidates[@]}"; do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return
        fi
    done

    local name
    for name in python3 python; do
        if command -v "$name" >/dev/null 2>&1; then
            command -v "$name"
            return
        fi
    done

    cat >&2 <<'EOF'
No usable Python found, and the studio is Python.
Create the repo venv and install the studio's lock:

    python -m venv python
    src/studio/install.sh          # src\studio\install.cmd on Windows

or put python on PATH, or set POLSON_PYTHON.
EOF
    exit 1
}

# Prints the command to run the CLI, one argument per line, so a path with a space survives.
find_cli() {
    if [ -n "${POLSON_CLI:-}" ]; then
        case "$POLSON_CLI" in
            *.dll) printf '%s\n%s\n' dotnet "$POLSON_CLI" ;;
            *)     printf '%s\n' "$POLSON_CLI" ;;
        esac
        return
    fi

    local apphost="Polson.CLI"
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) apphost="Polson.CLI.exe" ;;
    esac

    # One output directory rather than a Release/Debug search: the CLI builds to bin/cli, which is
    # what an agent harness's .mcp.json already points at.
    local dir="$repo_root/bin/cli"

    # The apphost when the build produced one, because it needs no dotnet on PATH.
    if [ -x "$dir/$apphost" ]; then
        printf '%s\n' "$dir/$apphost"
        return
    fi
    if [ -f "$dir/Polson.CLI.dll" ]; then
        printf '%s\n%s\n' dotnet "$dir/Polson.CLI.dll"
        return
    fi

    cat >&2 <<'EOF'
The Polson CLI is not built. Run:
    ./build
or set POLSON_CLI to the path of Polson.CLI.dll.
EOF
    exit 1
}

# The CLI's own help cannot mention a verb it does not have, so this script says it afterwards.
show_extra_verbs() {
    cat <<'EOF'
  studio            Serve the studio over a directory of projects: the live trace, the
                    renders beside the scripts that made them, and the sense-making curve.
                    Python, and needs the python/ venv - see README.md.

  orchestrator      Drive one turn against a project from the terminal, with you as the
                    director. Python, and needs the driver lock - see README.md.

EOF
}

# Which lock this interpreter actually has, in one word: driver, studio, or none.
#
# Asked of the interpreter rather than guessed from a site-packages path, because that path differs
# by platform and POLSON_PYTHON may name something that is not a venv at all. One spawn, and only on
# the verbs that need it — a verb that is about to start an agent can afford 100ms to say why it
# cannot. `google.antigravity` is the same spec `src/tests/__init__.py` tests for.
#
# **`google` is tested first, and that is not redundant.** `find_spec` imports a submodule's parent,
# so `find_spec("google.antigravity")` RAISES ModuleNotFoundError on an interpreter with no `google`
# at all rather than returning None — measured on a bare python3.13. Short-circuiting on the parent
# keeps the probe an answer rather than a crash swallowed by the fallback.
#
# **The probe uses single quotes INSIDE Python and double quotes outside, in both scripts.** Written
# the other way round PowerShell strips the inner double quotes on the way to a native command, and
# python -c then sees bare identifiers: `NameError: name 'google' is not defined`, swallowed by the
# exit-code fallback and reported as "neither lock installed" on a machine that had both.
installed_lock() {
    "$1" -c "import importlib.util as u; print('driver' if u.find_spec('google') and u.find_spec('google.antigravity') else ('studio' if u.find_spec('fastapi') else 'none'))" 2>/dev/null || echo none
}

require_driver() {
    local python="$1" verb="$2" lock
    lock="$(installed_lock "$python")"
    [ "$lock" = "driver" ] && return 0

    if [ "$lock" = "studio" ]; then
        cat >&2 <<EOF
polson $verb drives an agent, and the Antigravity SDK is not installed in this environment.

    interpreter   $python
    found         a Python environment with fastapi but no agent SDK — the studio's base lock
                  (17 packages) looks like this, and so does the ADK venv at python-adk/
    needed        the driver lock (52 packages), which adds the Antigravity SDK

    src/studio/install.sh driver          # src\\studio\\install.cmd driver on Windows

\`polson studio\` needs none of that and works as it is.
EOF
    else
        cat >&2 <<EOF
polson $verb drives an agent, and this interpreter has neither lock installed.

    interpreter   $python

    python -m venv python
    src/studio/install.sh driver          # src\\studio\\install.cmd driver on Windows

Or set POLSON_PYTHON to an interpreter that already has the Antigravity SDK.
EOF
    fi
    exit 1
}

run_python() {
    local verb="$1" module="$2"
    shift 2
    # Its own statement, not an argument: a command substitution that fails inside an argument list
    # is not what `set -e` acts on, so `exec ""` would be the next thing to happen.
    local python
    python="$(find_python)"

    if needs_driver "$verb"; then
        require_driver "$python" "$verb"
    fi

    # So that argparse opens with "usage: polson studio" rather than naming a module nobody typed.
    export POLSON_VERB="$(basename "${BASH_SOURCE[0]}") $verb"

    # `studio` is a package under src/, so src/ has to be importable. Set on the path rather than by
    # changing directory, so a relative argument still resolves against the caller's own cwd —
    # `./polson studio projects` means the projects directory they can see, not one under src/.
    if [ -n "${PYTHONPATH:-}" ]; then
        export PYTHONPATH="$repo_root/src:$PYTHONPATH"
    else
        export PYTHONPATH="$repo_root/src"
    fi

    exec "$python" -m "$module" "$@"
}

verb="${1:-}"

# `polson help studio`, which the CLI would reject as a verb name it has never heard of.
#
# This goes through run_python, so a driver verb's `--help` is gated by the lock check too — which
# is deliberate rather than an oversight. `orchestrator/run.py` imports `google.antigravity` at
# module scope, so `python -m orchestrator --help` without the SDK dies on ModuleNotFoundError
# before argparse ever runs. A message naming the lock to install beats that traceback.
if is_help_token "$verb" && [ "$#" -ge 2 ] && module="$(python_module "$2")"; then
    run_python "$2" "$module" --help
fi

if module="$(python_module "$verb")"; then
    shift || true
    run_python "$verb" "$module" "$@"
fi

# Everything else is the CLI's, including an unknown verb: its parser writes a better error than a
# guess here would, and a verb added to the CLI works through this script without it being touched.
#
# Not mapfile: that is bash 4, and /bin/bash on macOS is still 3.2. The assignment is its own
# statement so that `set -e` sees find_cli's failure rather than an empty array.
cli_line="$(find_cli)"
cli=()
while IFS= read -r part; do cli+=("$part"); done <<< "$cli_line"

# **No arguments counts as asking for help, and this script has to agree with the CLI about that.**
# The CLI already treats an empty command line as `--help` — it has to, because `server` is its
# default verb and a bare invocation would otherwise sit on stdin forever printing nothing. But
# `is_help_token ""` is false, so a bare `polson` printed the .NET verbs and silently omitted the two
# this script owns: the one invocation most likely to be someone finding out what the verbs are.
if is_help_token "$verb" || [ "$#" -eq 0 ]; then
    # Not `exec`, and `|| code=$?` rather than a bare call: the extra verbs have to be printed after
    # the CLI's own help, and `set -e` would otherwise take a non-zero help exit as fatal.
    code=0
    "${cli[@]}" "$@" || code=$?
    show_extra_verbs
    exit "$code"
fi

exec "${cli[@]}" "$@"
