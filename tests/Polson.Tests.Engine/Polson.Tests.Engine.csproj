<Project Sdk="Microsoft.NET.Sdk">

  <!-- Polson.Engine checked as it ships. The doc tests are Polson.Tests.MCPServer's own files, compiled here against
       the engine: the reference it serves documents only calls it has, has every call it documents, and every runnable
       example in it runs. EngineSurfaceTests checks what the engine leaves out. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Polson.Engine\Polson.Engine.csproj" />
    <ProjectReference Include="..\..\src\Polson.Runtime\Polson.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Polson.Tests.MCPServer\ApiDocumentationTests.cs;..\Polson.Tests.MCPServer\CoreReferenceExampleTests.cs;..\Polson.Tests.MCPServer\SdkIndexCoverageTests.cs"
             LinkBase="MCPServer" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- TestsRuntime loads testappsettings.json, and *appsettings.json is ignored by git because the other suites'
         carry keys. The engine needs none, so its settings are committed under another name and copied under that one. -->
    <None Include="testsettings.json" Link="testappsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
