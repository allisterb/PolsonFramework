{
  "mcp": {
    "autoApprove": [
      "polson:*",
      "polson.ExecuteScript",
      "polson.History",
      "polson.MeasureSvgPath",
      "polson.RenderSvg",
      "polson.Search"
    ]
  },
  "tools": {
    "disabled": [
      "generate_image",
      "run_command"
    ]
  },
  "permissions": {
    "call_mcp_tool": "allow",
    "default_api:call_mcp_tool": "allow",
    "polson:*": "allow",
    "polson:ExecuteScript": "allow",
    "polson:History": "allow",
    "polson:MeasureSvgPath": "allow",
    "polson:RenderSvg": "allow",
    "polson:Search": "allow",
    "generate_image": "deny",
    "default_api:generate_image": "deny",
    "run_command": "deny",
    "default_api:run_command": "deny"
  }
}